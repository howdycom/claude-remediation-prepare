{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // prepare.ts runs straight from source on the runner (`node prepare.ts`)
    // via Node's type stripping, so there is no emit step: `npm run build`
    // is a typecheck only, and the file must stick to erasable syntax
    // (no enums, namespaces, or other runtime-emitted TypeScript).
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["prepare.ts"]
}
